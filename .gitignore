# 인증값과 비밀정보: 예제에는 안전한 자리표시자만 둔다.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# 다시 만들 수 있는 개발 환경과 의존성
.venv/
venv/
node_modules/
__pycache__/
*.py[cod]

# 검사 도구와 빌드 캐시
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.cache/
/build/
/dist/

# 실행 중 생기는 로컬 DB와 임시 파일
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.tmp
*.log

# 운영체제 보조 파일
.DS_Store
Thumbs.db

# 승인된 교안 원본은 별도 보존하고 출처·해시·검사 결과만 버전 관리한다.
/01_참고자료/원본데이터/

# 실행별 기록·합성/실제 보고서는 코드와 분리해서 보존한다.
/03_실행데이터/
/04_산출물/

# 전체 화면 스파이크의 재생성 가능한 빌드·격리 시험 데이터
/02_구현/전체화면_스파이크/화면/dist/
/02_구현/전체화면_스파이크/검증결과/임시*/
/.impeccable/review/
/.impeccable/build/

# 실제 보고서 내려받기 사본은 실행 데이터다. 검증에는 메타데이터/해시만 기록한다.
/02_구현/전체화면_스파이크/검증결과/실제연구_*/🧾 실제 연구 보고서.md
/02_구현/전체화면_스파이크/검증결과/실제연구_첫검사/
/02_구현/전체화면_스파이크/검증결과/실제연구_표시보완검사/
