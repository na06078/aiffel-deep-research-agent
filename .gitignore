# 인증값과 비밀정보: 예제에는 안전한 자리표시자만 둔다.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# 다시 만들 수 있는 개발 환경과 의존성
.venv/
venv/
node_modules/
__pycache__/
*.py[cod]

# 검사 도구와 빌드 캐시
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.cache/
/build/
/dist/

# 실행 중 생기는 로컬 DB와 임시 파일
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.tmp
*.log

# 운영체제 보조 파일
.DS_Store
Thumbs.db

# 승인된 교안 원본은 별도 보존하고 출처·해시·검사 결과만 버전 관리한다.
/01_참고자료/원본데이터/

# 실행별 기록·합성/실제 보고서는 코드와 분리해서 보존한다.
/03_실행데이터/
/04_산출물/

# 스파이크 빌드·시험의 재생성 가능한 파일
/02_구현/스파이크/화면/dist/
/02_구현/스파이크/검증결과/임시/
/02_구현/스파이크/검증결과/임시_*/
# 중간 실행의 큰 캡처는 로컬에 보존하고 최종 캡처·구조화 결과만 기록한다.
/02_구현/스파이크/검증결과/첫검사/*.png
/02_구현/스파이크/검증결과/첫검사/*.md
/02_구현/스파이크/검증결과/시각표시_GREEN/*.md
/02_구현/스파이크/검증결과/역할범위_RED/*.md
